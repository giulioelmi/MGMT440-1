# The agent service (backend/agent). Built from the repo root because it depends on the
# @lumina/contract workspace package. Deployed privately on Fly (fly.agent.toml).
FROM node:22-slim

WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/contract packages/contract
COPY backend/agent backend/agent
# npm ci checks the whole workspace against the lockfile, so every package.json is needed.
COPY backend/gateway/package.json backend/gateway/
COPY web/package.json web/
RUN npm ci && npm run build -w @lumina/contract && npm run build -w @lumina/agent

# The service resolves runs/ and the root .env relative to its own folder (../../).
WORKDIR /app/backend/agent
ENV NODE_ENV=production
EXPOSE 8000
CMD ["node", "dist/index.js"]
